# Internal API URL for server-side SSR/load functions
API_BASE_URL="http://localhost:4000"

# Browser-facing API URL (used by client-side fetch)
PUBLIC_API_URL="http://localhost:4000"

# Internal unlimited API key (server-side only, never expose to browser)
INTERNAL_API_KEY="internal_super_secret_change_this"

# Public-facing origin of the web app (for BetterAuth callbacks and CORS)
PUBLIC_ORIGIN="http://localhost:5173"
